37625>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37628>>>        Case Begin
37628>>>            Case (NavigateData.eNavigateType = nfFromMain)
37630>>>                Send ShowInfoBox "Vengo desde el Select de la misma tabla (Main)" "From Main - ZoomLiga"
37631>>>                Case Break
37632>>>
37632>>>            Case (NavigateData.eNavigateType = nfFromParent)
37635>>>                Send ShowInfoBox "Vengo desde una tabla padre (Parent)" "From Parent - ZoomLiga"
37636>>>                Case Break
37637>>>
37637>>>            Case (NavigateData.eNavigateType = nfFromChild)
37640>>>                Send ShowInfoBox "Vengo desde una tabla hija (Child)" "From Child - ZoomLiga"
37641>>>                Case Break
37642>>>
37642>>>            Case Else // must be nfUndefined
37642>>>                Send ShowInfoBox "Navegación sin relación entre tablas (Undefined)" "Undefined - ZoomLiga"
37643>>>
37643>>>        Case End
37643>>>
37643>>>        Send SetActionButtons
37644>>>
37644>>>    End_Procedure
