37720>>>
37720>>>        // let's hide all buttons and then Show the ones we want
37720>>>        WebSet pbRender of oEditBtn to False
37721>>>        WebSet pbRender of oSaveBtn to False
37722>>>        WebSet pbRender of oCancelChangesBtn to False
37723>>>        WebSet pbRender of oDeleteBtn to False
37724>>>
37724>>>        If (NavigateData.bReadOnly) Begin
37726>>>            WebSet pbRender of oEditBtn to True
37727>>>        End
37727>>>>
37727>>>        Else Begin
37728>>>            WebSet pbRender of oSaveBtn to True
37729>>>            WebSet pbRender of oCancelChangesBtn to True
37730>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37731>>>        End
37731>>>>
37731>>>    End_Procedure
