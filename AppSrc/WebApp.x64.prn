37745>>>        Case Begin
37745>>>            Case (NavigateData.eNavigateType = nfFromMain)
37747>>>                // If from main, this is a propbably a main file Select to Zoom.
37747>>>                Case Break
37748>>>
37748>>>            Case (NavigateData.eNavigateType = nfFromParent)
37751>>>                // If from parent, this is a constrained drill down.
37751>>>                Case Break
37752>>>
37752>>>            Case (NavigateData.eNavigateType = nfFromChild)
37755>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37755>>>                Case Break
37756>>>
37756>>>            Case Else // must be nfUndefined
37756>>>
37756>>>        Case End
37756>>>
37756>>>        Send SetActionButtons
37757>>>
37757>>>    End_Procedure
