37764>>>Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37767>>>    Case Begin
37767>>>        Case (NavigateData.eNavigateType = nfFromMain)
37769>>>            Send ShowInfoBox "Vengo desde el Select de la misma tabla (Main)" "From Main - ZoomPosicion"
37770>>>            Case Break
37771>>>
37771>>>        Case (NavigateData.eNavigateType = nfFromParent)
37774>>>            Send ShowInfoBox "Vengo desde una tabla padre (Parent)" "From Parent - ZoomPosicion"
37775>>>            Case Break
37776>>>
37776>>>        Case (NavigateData.eNavigateType = nfFromChild)
37779>>>            Send ShowInfoBox "Vengo desde una tabla hija (Child)" "From Child - ZoomPosicion"
37780>>>            Case Break
37781>>>
37781>>>        Case Else // must be nfUndefined
37781>>>            Send ShowInfoBox "Navegación sin relación entre tablas (Undefined)" "Undefined - ZoomPosicion"
37782>>>
37782>>>    Case End
37782>>>
37782>>>    Send SetActionButtons
37783>>>
37783>>>End_Procedure
37784>>>
37784>>>
37784>>>End_Object 
