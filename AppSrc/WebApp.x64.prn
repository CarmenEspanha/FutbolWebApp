38237>>>        Case Begin
38237>>>            Case (NavigateData.eNavigateType = nfFromMain)
38239>>>                // If from main, this is a propbably a main file Select to Zoom.
38239>>>                Case Break
38240>>>
38240>>>            Case (NavigateData.eNavigateType = nfFromParent)
38243>>>                // If from parent, this is a constrained drill down.
38243>>>                Case Break
38244>>>
38244>>>            Case (NavigateData.eNavigateType = nfFromChild)
38247>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38247>>>                Case Break
38248>>>
38248>>>            Case Else // must be nfUndefined
38248>>>
38248>>>        Case End
38248>>>
38248>>>        Send SetActionButtons
38249>>>
38249>>>    End_Procedure
