38206>>>
38206>>>    Procedure SetActionButtons
38209>>>        tWebNavigateData NavigateData
38209>>>        tWebNavigateData NavigateData
38209>>>        Boolean bHasRecord
38209>>>        Handle hoDD
38209>>>
38209>>>        Get Server to hoDD
38210>>>        Get GetNavigateData to NavigateData
38211>>>        Get HasRecord of hoDD to bHasRecord
38212>>>
38212>>>        // let's hide all buttons and then Show the ones we want
38212>>>        WebSet pbRender of oEditBtn to False
38213>>>        WebSet pbRender of oSaveBtn to False
38214>>>        WebSet pbRender of oCancelChangesBtn to False
38215>>>        WebSet pbRender of oDeleteBtn to False
38216>>>
38216>>>        If (NavigateData.bReadOnly) Begin
38218>>>            WebSet pbRender of oEditBtn to True
38219>>>        End
38219>>>>
38219>>>        Else Begin
38220>>>            WebSet pbRender of oSaveBtn to True
38221>>>            WebSet pbRender of oCancelChangesBtn to True
38222>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38223>>>        End
38223>>>>
38223>>>    End_Procedure
38224>>>
38224>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38227>>>        // Close after save
38227>>>        Send NavigateClose Self
38228>>>    End_Procedure
38229>>>
38229>>>    // this will close the view after a delete
38229>>>    Procedure OnViewDeleted Handle hoDDO
38232>>>        Send NavigateClose Self
38233>>>    End_Procedure
